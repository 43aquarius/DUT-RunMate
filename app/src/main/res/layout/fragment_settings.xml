<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_detect" />

            <!-- 默认半径 -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_default_radius" />
                <TextView android:id="@+id/tvRadius" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="25 m" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRadius" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="15" android:valueTo="80"
                    android:stepSize="5" />
            </LinearLayout>

            <!-- 预告距离 -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_approach" />
                <TextView android:id="@+id/tvApproach" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="60 m" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderApproach" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="30" android:valueTo="150"
                    android:stepSize="10" />
            </LinearLayout>

            <!-- 确认阈值 -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_confirm_delta" />
                <TextView android:id="@+id/tvDelta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="3 m" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDelta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="1" android:valueTo="10"
                    android:stepSize="1" />
            </LinearLayout>

            <!-- 轮询间隔 -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_poll_interval" />
                <TextView android:id="@+id/tvPoll" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="3 s" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPoll" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="2" android:valueTo="15"
                    android:stepSize="1" />
            </LinearLayout>

            <!-- 宽限期 -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_grace" />
                <TextView android:id="@+id/tvGrace" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="12 s" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderGrace" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="5" android:valueTo="40"
                    android:stepSize="5" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_alert" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_tts" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="经耳机/扬声器播报状态" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swTts" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_chime" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="短促提示音" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swChime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_vibrate" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="成功轻震·漏卡强震" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swVibrate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_api" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_api_enabled" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/api_enabled_off" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swApi" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_map" />

            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_tile" />
                <RadioGroup android:id="@+id/rgTile" android:orientation="horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbTileSat" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_tile_sat"
                        android:layout_weight="1" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbTileStreet" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_tile_street"
                        android:layout_weight="1" />
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_coord" />
                <RadioGroup android:id="@+id/rgCoord" android:orientation="horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbCoordWgs" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_coord_wgs"
                        android:layout_weight="1" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbCoordGcj" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_coord_gcj"
                        android:layout_weight="1" />
                </RadioGroup>
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_update" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_upd_auto" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/pref_upd_auto_sub" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swUpdAuto" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_upd_server" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:hint="@string/pref_upd_server_hint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUpdServer" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textUri"
                        android:imeOptions="actionDone" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/pref_upd_server_sub" />
                <com.google.android.material.button.MaterialButton
                    style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnUpdCheck"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/pref_upd_check_now" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_system" />

            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnBattery"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/pref_battery" />

            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnExport"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_export" />

            <TextView android:id="@+id/tvAbout" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
