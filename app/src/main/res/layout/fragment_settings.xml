<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- v1.8.14：账号登录分区（由原「接口」Tab 整体并入；接口调试功能已于 v1.8.13 移除） -->
            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_account" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/api_usage_hint" />

            <!-- v1.4.0 账号登录 · 一键配置（v1.8.14 移入设置页；v1.9.1 按用户需求精简：
                 卡内长说明全部移入「说明」对话框，卡片只留输入框与按钮） -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/colorSurfaceVariant" android:padding="16dp">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:text="@string/ws_card_title" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHelpApi" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/api_help" />
                </LinearLayout>
                <!-- v1.9.1：卡内长说明文案移入「说明」对话框（用户需求：卡片别太多字） -->
                <LinearLayout android:orientation="horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:hint="@string/ws_number_hint">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWsNumber" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="text"
                            android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/ws_pwd_hint" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWsPwd" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textPassword"
                            android:imeOptions="actionDone" android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWsLogin" style="@style/Widget.RunMate.PillButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/ws_btn_login" />
                <!-- v1.9.0：微信扫码登录（免输密码；需在微信中已绑定学校账号） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQrLogin" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/ws_btn_qr" />
                <!-- v1.9.1：「重新捕获 H5 参数」按钮移除（令牌失效直接重新登录即可；
                     H5 捕获页仍作为登录失败时的自动兑底保留，无手动入口） -->
                <TextView android:id="@+id/tvWsStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="" />

                <!-- v1.7.0 多账号：已保存账号 chips（点击切换为当前账号；长按删除；「＋」清空输入框录入新账号） -->
                <HorizontalScrollView
                    android:id="@+id/scrollAccounts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/layAccounts" android:orientation="horizontal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </HorizontalScrollView>

                <!-- v1.7.0 多账号：逐个用各账号自己的令牌/接口快照查询距离，汇总展示 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQueryAll" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:visibility="gone"
                    android:text="@string/acct_btn_query_all" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_detect" />

            <!-- v1.9.0：检测参数改手填（用户需求：直接手动填写，保留 1 位小数）。
             旧滑杆步长 1m 只能整数——现在可自定义精确参数（如 12.5m） -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_default_radius" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" app:suffixText="m"
                    android:hint="@string/pref_radius_range">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRadius" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:maxLength="6" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 预告距离（v1.9.0：手填，保留 1 位小数） -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_approach" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" app:suffixText="m"
                    android:hint="@string/pref_approach_range">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApproach" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:maxLength="6" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 确认阈值（v1.9.0：手填，保留 1 位小数） -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_confirm_delta" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" app:suffixText="m"
                    android:hint="@string/pref_delta_range">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDelta" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:maxLength="5" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 轮询间隔（v1.9.0：手填，保留 1 位小数） -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_poll_interval" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" app:suffixText="s"
                    android:hint="@string/pref_poll_range">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPoll" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:maxLength="5" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 宽限期（v1.9.0：手填，保留 1 位小数） -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_grace" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" app:suffixText="s"
                    android:hint="@string/pref_grace_range">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGrace" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"
                        android:maxLength="5" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- v1.9.0：跑步通知显示（用户需求：开始跑步后弹窗可自由选择是否出现在锁屏页面与状态栏） -->
            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_notif_section" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_notif_lock" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/pref_notif_lock_sub" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swNotifLock" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_notif_bar" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/pref_notif_bar_sub" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swNotifBar" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_alert" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_tts" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="经耳机/扬声器播报状态" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swTts" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_chime" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="短促提示音" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swChime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_vibrate" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="成功轻震·漏卡强震" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swVibrate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- v1.8.6：测试提醒——当场验证语音/提示音/震动三通道（用户实报三通道全无效后的自查入口） -->
            <!-- v1.8.13：分场景提醒开关——每种提醒的语音/震动独立开关 -->
            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle"
                android:id="@+id/btnAlertScn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_alert_scn" />

            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle"
                android:id="@+id/btnTestAlert"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_test_alert" />

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_api" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_api_enabled" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/api_enabled_off" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swApi" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_map" />

            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant" android:layout_marginTop="12dp"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_tile" />
                <RadioGroup android:id="@+id/rgTile" android:orientation="horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbTileSat" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_tile_sat"
                        android:layout_weight="1" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbTileStreet" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_tile_street"
                        android:layout_weight="1" />
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/pref_coord" />
                <RadioGroup android:id="@+id/rgCoord" android:orientation="horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbCoordWgs" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_coord_wgs"
                        android:layout_weight="1" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbCoordGcj" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/pref_coord_gcj"
                        android:layout_weight="1" />
                </RadioGroup>
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_update" />

            <!-- v1.6.0：按需求精简 —— 更新区块只保留一个「检查更新」按钮；
                 服务器地址已内置（主 dut-runmate.space-z.ai，不可达自动转 GitHub）
                 不再展示；自动检查保持默认开启（每天启动静默一次）。 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdCheck" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/pref_upd_check_now" />

            <!-- v1.6.0：GitHub 开源仓库入口（点击跳转浏览器） -->
            <LinearLayout android:id="@+id/rowGithub"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_github" android:contentDescription="@string/pref_github"
                    app:tint="?attr/colorOnSurface" />
                <LinearLayout android:orientation="vertical"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:text="@string/pref_github" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="@string/pref_github_sub" />
                </LinearLayout>
            </LinearLayout>

            <!-- v1.8.14：联系作者（邮箱）——点击发送邮件 / 复制邮箱地址 -->
            <LinearLayout android:id="@+id/rowContact"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_mail" android:contentDescription="@string/pref_contact"
                    app:tint="?attr/colorOnSurface" />
                <LinearLayout android:orientation="vertical"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:text="@string/pref_contact" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="@string/pref_contact_sub" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/TextAppearance.RunMate.Label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/pref_system" />

            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnBattery"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/pref_battery" />

            <!-- v1.8.3：系统通知设置直达（锁屏显示修复） -->
            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnNotifSetting"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_notif_setting" />

            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnExport"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_export" />

            <!-- v1.9.0：全部恢复默认（替代 v1.8.15「恢复默认打卡点」单一入口：
                 检测参数/提醒开关/通知显示/API/地图坐标/筛选 + 8 个默认点位一并重置；
                 账号登录信息不受影响） -->
            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnResetAll"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_reset_all" />
            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle" android:id="@+id/btnCrashLog"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/pref_crash_log" />

            <TextView android:id="@+id/tvAbout" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
