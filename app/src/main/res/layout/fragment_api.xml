<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scrollApi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- v1.6.1：标题 + 说明按钮（令牌/模板/H5入口都是干什么的） -->
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/TextAppearance.RunMate.Label"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/api_title" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHelpApi" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/api_help" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/api_usage_hint" />

            <!-- v1.4.0 账号登录 · 一键配置 -->
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/colorSurfaceVariant" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:text="@string/ws_card_title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/ws_card_hint" />
                <LinearLayout android:orientation="horizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:hint="@string/ws_number_hint">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWsNumber" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="text"
                            android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:hint="@string/ws_pwd_hint" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWsPwd" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textPassword"
                            android:imeOptions="actionDone" android:singleLine="true"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWsLogin" style="@style/Widget.RunMate.PillButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/ws_btn_login" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenH5" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:visibility="gone"
                    android:text="@string/ws_btn_open_h5" />
                <TextView android:id="@+id/tvWsStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:text="" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilToken" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:hint="@string/api_token_label"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etToken" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textPassword"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTokenSave" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/save" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="16dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/pref_api_enabled" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="@string/api_enabled_off" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swApiMode" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- v1.6.0：结果卡片提前到接口列表上方 —— 点击「发送测试」立即可见反馈，
                 不再需要等响应后滚动到底部（旧版反馈不可见问题修复） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:visibility="gone" app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="24dp" app:strokeWidth="0dp">
                <LinearLayout android:orientation="vertical" android:padding="20dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <!-- v1.6.1：文本可长按选中复制（旧版只能看不能复制） -->
                    <TextView android:id="@+id/tvApiStatus" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textIsSelectable="true"
                        android:text="@string/api_result_none" />
                    <TextView android:id="@+id/tvApiExtract" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurfaceVariant" android:text="" />
                    <ScrollView android:layout_width="match_parent" android:layout_height="240dp"
                        android:layout_marginTop="8dp" android:background="?attr/colorSurface"
                        android:padding="8dp">
                        <TextView android:id="@+id/tvApiBody" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                            android:fontFamily="monospace" android:textIsSelectable="true" android:text="" />
                    </ScrollView>
                    <!-- v1.6.1：一键复制完整结果（标题/URL/状态/响应体） -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyResult" style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:layout_gravity="end"
                        android:text="@string/api_result_copy" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfiles" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
